{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/birthday-email",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/monthly-report",
      "schedule": "0 0 1 * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
