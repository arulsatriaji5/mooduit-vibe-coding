{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/manifest.json", "destination": "/manifest.json" },
    { "source": "/sw.js", "destination": "/sw.js" },
    { "source": "/workbox-(.*)", "destination": "/workbox-$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
